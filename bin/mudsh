#!/bin/bash
set -e

# npm link resolves its bin entries via symlinks on both macOS and Linux.
launcher=${BASH_SOURCE[0]}
while [[ -L "$launcher" ]]; do
  link=$(readlink "$launcher")
  case $link in
    /*) launcher=$link ;;
    *) launcher=$(dirname "$launcher")/$link ;;
  esac
done
root=$(cd -- "$(dirname "$launcher")/.." && pwd -P)
image=mudsh-ai:local

# Parse the user's file as literal data even if its contents are shell code.
read_rc() {
  local rc="${HOME:?}/.mudshrc" number=1
  harbor_project=
  npm_registry=
  export MUDSH_ALLOW_REMOTE_HTTP=false
  [[ -e $rc || -L $rc ]] || return 0
  if [[ ! -f $rc || ! -r $rc ]]; then
    echo "Cannot read ~/.mudshrc as a regular file." >&2
    return 2
  fi
  if ! parse_rc < "$rc"; then
    echo "Invalid ~/.mudshrc at line $number. See the repository's .mudshrc example." >&2
    return 2
  fi
}

parse_rc() {
  local line key value
  local harbor_pattern='^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$'
  local npm_pattern='^https?://(\[[0-9a-fA-F:]+\]|[a-zA-Z0-9.-]+)(:[0-9]+)?(/[a-zA-Z0-9._~/-]*)?$'
  IFS= read -r line || [[ -n $line ]] || return 1
  [[ ${line%$'\r'} == 'return 0' ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    number=$((number + 1))
    line=${line%$'\r'}
    case $line in ''|'#'*) continue ;; esac
    [[ $line == *=* ]] || return 1
    key=${line%%=*}
    value=${line#*=}
    case $key in
      harbor_project)
        [[ -z $value || $value =~ $harbor_pattern ]] || return 1
        harbor_project=$value
        ;;
      npm_registry)
        [[ -z $value || $value =~ $npm_pattern ]] || return 1
        npm_registry=$value
        ;;
      allow_remote_http)
        [[ $value == true || $value == false ]] || return 1
        MUDSH_ALLOW_REMOTE_HTTP=$value
        ;;
      *) return 1 ;;
    esac
  done
  return 0
}

run_console() {
  if ! read_rc; then
    # Keep the login shell available to repair a malformed rc.
    if [[ $1 != login ]]; then exit 2; fi
    export MUDSH_ALLOW_REMOTE_HTTP=false
  fi
  local node_command= built_node=
  if [[ -r "$root/dist-native/node-path" ]]; then
    IFS= read -r built_node < "$root/dist-native/node-path" || built_node=
  fi
  # A fresh login may not have loaded the version manager used to build mudsh.
  if [[ $1 == login && -x "$built_node" ]]; then
    node_command=$built_node
  else
    node_command=$(command -v node) || node_command=
  fi
  if [[ ! -x "$node_command" ]]; then
    for node_command in /opt/homebrew/bin/node /usr/local/bin/node; do
      if [[ -x "$node_command" ]]; then break; fi
    done
  fi
  if [[ ! -x "$node_command" ]]; then
    node_command=$built_node
  fi
  if [[ ! -x "$node_command" || ! -f "$root/dist-native/console.mjs" ]]; then
    echo "Install Node.js 24 and run npm ci && npm run build to prepare mudsh." >&2
    exit 1
  fi
  export MUDSH_LAUNCHER="$root/bin/mudsh"
  unset MUDSH_GAME_ROOT
  exec "$node_command" "$root/dist-native/console.mjs" "$root" "$@"
}

raw_bash() {
  export MUDSH_LAUNCHER="$root/bin/mudsh"
  unset MUDSH_GAME_ROOT
  if (( $# )); then exec /bin/bash "$@"; fi
  exec /bin/bash --rcfile "$root/native/shell.bash" -i
}

case ${1-} in
  sprite)
    shift
    run_console settings "$@"
    ;;
  install-deps)
    read_rc
    cd -- "$root"
    if [[ -n $npm_registry ]]; then exec npm ci --registry "$npm_registry"; fi
    exec npm ci
    ;;
  build-image)
    read_rc
    if [[ ! -f "$root/dist-native/game.mjs" ]]; then
      echo "Run npm run build to prepare the native image." >&2
      exit 1
    fi
    exec docker build --tag "$image" --build-arg "NODE_IMAGE=${harbor_project:+$harbor_project/}node:24-bookworm-slim" "$root/dist-native"
    ;;
  play)
    shift
    profile=${MUDSH_PROFILE:-default}
    if [[ ! $profile =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$ ]]; then
      echo "Use letters, digits, hyphens or underscores for MUDSH_PROFILE." >&2
      exit 2
    fi
    if ! docker info --format '{{.ServerVersion}}' >/dev/null 2>&1; then
      echo "Start Docker to play the isolated dungeon." >&2
      exit 1
    fi
    if ! docker image inspect "$image" >/dev/null 2>&1; then
      echo "Run mudsh build-image to prepare the dungeon container." >&2
      exit 1
    fi
    if (( $# == 0 )); then run_console dungeon; fi
    tty=()
    if [[ ${1-} != --bridge && -t 0 && -t 1 ]]; then tty=(--tty); fi
    if [[ ${1-} == --bash ]]; then shift; fi
    color_env=()
    if [[ -n ${NO_COLOR-} ]]; then color_env+=(--env NO_COLOR); fi
    if [[ ${TERM-} == dumb ]]; then color_env+=(--env TERM=dumb); fi
    exec docker run --rm --interactive "${tty[@]}" --init \
      --name "mudsh-ai-$profile" --network none --read-only --cap-drop ALL \
      --security-opt no-new-privileges --pids-limit 96 --memory 256m --cpus 1 \
      --mount "type=volume,source=mudsh-ai-save-$profile,target=/expedition" \
      --tmpfs /tmp:rw,nosuid,nodev,noexec,size=16m \
      "${color_env[@]}" "$image" "$@"
    ;;
  --bash)
    shift
    raw_bash "$@"
    ;;
  --help)
    printf '%s\n' 'mudsh               Open a local MUD shell backed by Bash' \
      'mudsh play          Play the dungeon in an isolated MUD shell' \
      'mudsh sprite setup  Configure the sprite and its model' \
      'mudsh --login       Open a MUD session with Bash login startup' \
      'mudsh --bash        Open an ordinary interactive Bash session' \
      'mudsh play --bash   Play the dungeon in ordinary interactive Bash' \
      'mudsh install-deps  Install project dependencies from the configured npm registry' \
      'mudsh build-image   Build the playable container from the local project'
    ;;
  *)
    case ${1-} in
      -l|--login) (( $# == 1 )) && run_console login ;;
    esac
    if (( $# )); then exec /bin/bash "$@"; fi
    run_console host
    ;;
esac
